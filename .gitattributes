# Auto-detect text files
* text=auto

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Terraform
*.tf text eol=lf
*.tfvars text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Java
*.java text eol=lf

# Maven Wrapper
mvnw text eol=lf
mvnw.cmd text eol=crlf